import("//build/default_targets.gni")
import("//build/templates/board.gni")

blueos_board("qemu_riscv64") {
  kernel_config = {
    cflags = [ "--static" ]
    ldflags = [
      "-nostartfiles",
      "-Wl,-gc-sections",
      "-Wl,-z,norelro",
    ]
    if (build_type == "debug") {
      # The boot filesystem retains the full debug ELF files in tmpfs.
      ldflags += [ "-Wl,--defsym=__blueos_heap_size=0x2000000" ]
    } else {
      ldflags += [ "-Wl,--defsym=__blueos_heap_size=0x800000" ]
    }
    rustflags = [
      "--cfg",
      "target_board=\"qemu_riscv64\"",
      "-Zemit-stack-sizes",
      "-Crelocation-model=static",
      "-Clinker=clang",
      "-Clink-arg=-fuse-ld=lld",
      "-Clink-arg=--target=riscv64",
      "-Clink-arg=-march=rv64",
      "-Clink-arg=-mabi=lp64",
    ]
    foreach(item, ldflags) {
      rustflags += [ "-Clink-arg=${item}" ]
    }
  }

  app_config = {
    rustflags = [
      "--cfg",
      "target_board=\"qemu_riscv64\"",
      "-Clinker=clang",
      "-Clink-arg=-fuse-ld=lld",
      "-Clink-arg=--target=riscv64",
      "-Clink-arg=-march=rv64",
      "-Clink-arg=-mabi=lp64",
      "-Clink-arg=-Wl,-z,norelro",
    ]
  }

  dynamic_config = {
    # PIC disables small-data addressing. Clang 19 warns on an explicit limit.
    cflags = [
      "-march=rv64imac",
      "-mabi=lp64",
      "-ffreestanding",
    ]
    ldflags = [
      "-fuse-ld=lld",
      "-march=rv64imac",
      "-mabi=lp64",
      "-Wl,--no-relax",
    ]
    rustflags = [
      "-Crelocation-model=pic",
      "-Cpanic=abort",
      "-Clinker=clang",
      "-Clinker-flavor=gcc",
      "-Clink-arg=--target=riscv64",
    ]
    foreach(item, ldflags) {
      rustflags += [ "-Clink-arg=${item}" ]
    }
  }

  default = [ "//apps/shell:shell_runner" ]
  _check_all = check_all_on_virtual_board + clippy_all_on_virtual_board
  check_all = filter_exclude(_check_all, [ "//kernel/adapter*" ])
  if (!coverage && !profile) {
    check_all += [ "//kernel/tests:check_dynamic" ]
  }
}
