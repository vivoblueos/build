declare_args() {
  chip = "esp32c6"
}

# ESP32-C6 (rv32imac) reuses the existing imac toolchain — the rustc target
# `riscv32-vivo-blueos` already carries the `+a` atomic extension. See
# build/toolchain/BUILD.gn:blueos_riscv32imac (also used by gd32vw553_eval).
board_default_toolchain = "//build/toolchain:blueos_riscv32imac"
default_linker_script = "//kernel/kernel/src/boards/${board}/link.x"

# NOTE: the Espressif qemu fork (`qemu-esp32-riscv32`) is not installed on this
# host, and upstream QEMU has no esp32c6 machine. QEMU boot is therefore blocked
# here (same as for seeed_xiao_esp32c3). The config is written in full so that
# `gn gen`/`ninja` still produce the esp32 image + runner scripts; verification
# runs through Wokwi instead. See memory/qemu-esp32-fork-missing.md.
qemu_exe = "qemu-esp32-riscv32"
qemu_machine = "esp32c6"
rust_abi_target = "riscv32"
qemu_extra_args = []
qemu_net_args = []
qemu_block_args = []

# Bootloader / partition table for the esp32 image merge stage. C6 assets are
# fetched at image-build time (only needed for `unittest_runner` / Wokwi
# firmware.bin, not for `:blueos` ELF compilation). If the release below lacks a
# c6 variant, swap in a locally generated pair (espflash/esp-idf) at stage B.
qemu_esp32_bootloader_bin = "https://github.com/vivoblueos/toolchain/releases/download/v0.8.0/esp32c6-bootloader.bin"
qemu_esp32_partition_table_bin = "https://github.com/vivoblueos/toolchain/releases/download/v0.8.0/esp32c6-partition-table.bin"
qemu_use_esp32_loader = true

# WiFi/net 驱动依赖。与 seeed_xiao_esp32c3.gni 同构,仅把 c3 专属 crate 换成 c6:
#   esp-wifi-sys-esp32c3-0.2.0 → esp-wifi-sys-esp32c6-0.2.0
#   esp32c3-0.32.2            → esp32c6-0.23.0
# 其余 7 个(esp-hal/esp-phy/esp-radio-rtos-driver/esp-rom-sys/esp-sync/smoltcp/enumset)
# 版本号与 C3 共用同一 vendor 目录。这些 crate 仅被 #[cfg(enable_net)] 的 net 模块
# 引用;agent_loop 的 app.conf 开了 CONFIG_ENABLE_NET=y 才会真正链入 kernel。
board_deps = [
  "//external/vendor/enumset-1.1.13:enumset",
  "//external/vendor/esp-hal-1.1.1:esp_hal",
  "//external/vendor/esp-phy-0.2.0:esp_phy",
  "//external/vendor/esp-radio-rtos-driver-0.3.0:esp_radio_rtos_driver",
  "//external/vendor/esp-rom-sys-0.1.4:esp_rom_sys",
  "//external/vendor/esp-sync-0.2.1:esp_sync",
  "//external/vendor/esp-wifi-sys-esp32c6-0.2.0:esp_wifi_sys_esp32c6",
  "//external/vendor/esp32c6-0.23.0:esp32c6",
  "//external/vendor/smoltcp-0.12.0:smoltcp",
]
