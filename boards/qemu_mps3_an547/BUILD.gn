import("//build/default_targets.gni")
import("//build/templates/board.gni")
import("//build/templates/linker_script.gni")

_target_linker = "arm-none-eabi-gcc"
_sysroot =
    exec_script("//build/scripts/get_sysroot.py", [ _target_linker ], "string")

generate_linker_script("default_linker_script") {
  preprocessor = "arm-none-eabi-gcc"
  template = "//kernel/arch/arm/cortex_m/link.x"
  output = "${root_gen_dir}/link.pre.ld"
}

blueos_board("qemu_mps3_an547") {
  kernel_config = {
    cflags = [
      "--target=thumbv8m.main-none-eabihf",
      "-mthumb",
      "-mcpu=cortex-m55",
      "-march=armv8.1-m.main+mve.fp+fp.dp",
      "-mfpu=fpv5-d16",
      "-mfloat-abi=hard",
      "--static",
      "-fshort-enums",
      "-fsigned-char",
      "-nostdlib",
      "-isystem",
      "${_sysroot}/include",
    ]
    ldflags = [
      "-mthumb",
      "-mcpu=cortex-m55",
      "-march=armv8.1-m.main+mve.fp+fp.dp",
      "-mfpu=fpv5-d16",
      "-mfloat-abi=hard",
      "-nostartfiles",
      "-Wl,-gc-sections",
      "-Wl,-z,norelro",
    ]
    rustflags = [
      "--cfg",
      "target_board=\"qemu_mps3_an547\"",
      "--cfg",
      "cortex_m",
      "--cfg",
      "armv8m",
      "--cfg",
      "armv8m_main",
      "--cfg",
      "has_fpu",
      "-Zemit-stack-sizes",
      "-Crelocation-model=static",
      "-Clinker=${_target_linker}",
    ]
    foreach(item, ldflags) {
      rustflags += [ "-Clink-arg=${item}" ]
    }
  }
  app_config = {
    rustflags = [
      "-Clinker=clang",
      "-Clink-arg=-fuse-ld=lld",
      "-Clink-arg=--target=thumbv8m.main-none-eabihf",
      "-Clink-arg=-Wl,-z,norelro",
    ]
  }
  dynamic_config = {
    cflags = [
      "-mthumb",
      "-mcpu=cortex-m55",
      "-march=armv8.1-m.main+mve.fp+fp.dp",
      "-mfpu=fpv5-d16",
      "-mfloat-abi=hard",
      "-ffreestanding",
      "-fshort-enums",
      "-fsigned-char",
    ]
    ldflags = [
      "-mthumb",
      "-mcpu=cortex-m55",
      "-march=armv8.1-m.main+mve.fp+fp.dp",
      "-mfpu=fpv5-d16",
      "-mfloat-abi=hard",

      # GNU ld's long Thumb PLT keeps .rel.plt offsets valid for the loader.
      "-Wl,--long-plt",
    ]
    rustflags = [
      "-Crelocation-model=pic",
      "-Cpanic=abort",
      "-Clinker=${_target_linker}",
      "-Clinker-flavor=gcc",
    ]
    foreach(item, ldflags) {
      rustflags += [ "-Clink-arg=${item}" ]
    }
  }
  default = [
    "//apps/example:check_apps",
    "//apps/shell:shell_runner",
  ]
  check_all = check_all_on_virtual_board + clippy_all_on_virtual_board +
              [ "//apps/example:check_apps" ]
  if (!coverage && !profile) {
    check_all += [ "//kernel/tests:check_dynamic" ]
  }
}
